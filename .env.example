# AI Provider Configuration - copy to .env and fill
# Never commit .env with real keys

# Provider: openai | mock (default mock if no key)
AI_PROVIDER=openai

# OpenAI-compatible (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative generic
# AI_API_KEY=...
# AI_MODEL=...

# Server
PORT=3000
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
