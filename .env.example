# AI Provider Configuration - copy to .env and fill
# Never commit .env with real keys

# Provider: openai | mock (default mock if no key)
AI_PROVIDER=openai

# OpenAI-compatible (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative generic
# AI_API_KEY=...
# AI_MODEL=...

# Server
PORT=3000
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# YouTube cookies (optional). Datacenter hosts (Render, Railway, VPS) get
# "Sign in to confirm you're not a bot" on some videos; cookies from a
# signed-in session fix it. Export a Netscape-format cookies.txt and set ONE:
#   YTDLP_COOKIES_FILE=./cookies.txt          (path to the file)
#   YTDLP_COOKIES_B64=<base64 of that file>   (for hosts without file uploads)
# Never commit cookies.txt or share the base64 value.
